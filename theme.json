{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"color": {
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"palette": [
				{
					"color": "#ffffff",
					"name": "Base",
					"slug": "base"
				},
				{
					"color": "#111111",
					"name": "Contrast",
					"slug": "contrast"
				},
				{
					"color": "#0a2624",
					"name": "Deep Teal",
					"slug": "deep-teal"
				},
				{
					"color": "#152f2c",
					"name": "Dark Teal",
					"slug": "dark-teal"
				},
				{
					"color": "#445956",
					"name": "Muted Teal",
					"slug": "muted-teal"
				},
				{
					"color": "#b8bfb0",
					"name": "Sage Gray",
					"slug": "sage-gray"
				},
				{
					"color": "#eaeade",
					"name": "Soft Ivory",
					"slug": "soft-ivory"
				},
				{
					"color": "#eae6da",
					"name": "Warm Ivory",
					"slug": "warm-ivory"
				},
				{
					"color": "#fff5df",
					"name": "Cream",
					"slug": "cream"
				},
				{
					"color": "#f9f2f6",
					"name": "Blush White",
					"slug": "blush-white"
				},
				{
					"color": "#eddaf3",
					"name": "Light Lavender",
					"slug": "light-lavender"
				},
				{
					"color": "#e5e8ec",
					"name": "Cool Gray",
					"slug": "cool-gray"
				}
			]
		},
		"position": {
			"sticky": true
		},
		"layout": {
			"contentSize": "900px",
			"wideSize": "1840px"
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{
					"name": "Tiny",
					"size": "10px",
					"slug": "20"
				},
				{
					"name": "X-Small",
					"size": "20px",
					"slug": "30"
				},
				{
					"name": "Small",
					"size": "30px",
					"slug": "40"
				},
				{
					"name": "Regular",
					"size": "clamp(30px, 5vw, 50px)",
					"slug": "50"
				},
				{
					"name": "Large",
					"size": "clamp(30px, 7vw, 70px)",
					"slug": "60"
				},
				{
					"name": "X-Large",
					"size": "clamp(50px, 7vw, 90px)",
					"slug": "70"
				},
				{
					"name": "XX-Large",
					"size": "clamp(70px, 10vw, 140px)",
					"slug": "80"
				}
			],
			"units": [
				"%",
				"px",
				"em",
				"rem",
				"vh",
				"vw"
			]
		},
		"typography": {
			"writingMode": false,
			"fluid": true,
			"fontWeight": true,
			"defaultFontSizes": false,
			"fontSizes": [
				{ "slug": "xs",       "name": "XS",    "size": "0.75rem",  "fluid": { "min": "0.7rem",   "max": "0.8rem"   } },
				{ "slug": "sm",       "name": "SM",    "size": "0.875rem", "fluid": { "min": "0.8rem",   "max": "0.95rem"  } },
				{ "slug": "base",     "name": "Base",  "size": "1rem",     "fluid": { "min": "0.95rem",  "max": "1.1rem"   } },
				{ "slug": "lg",       "name": "LG",    "size": "1.125rem", "fluid": { "min": "1rem",     "max": "1.25rem"  } },
				{ "slug": "xl",       "name": "XL",    "size": "1.25rem",  "fluid": { "min": "1.1rem",   "max": "1.4rem"   } },
				{ "slug": "2xl",      "name": "2XL",   "size": "1.5rem",   "fluid": { "min": "1.25rem",  "max": "1.75rem"  } },
				{ "slug": "3xl",      "name": "3XL",   "size": "1.875rem", "fluid": { "min": "1.5rem",   "max": "2.25rem"  } },
				{ "slug": "3fivexl", "name": "3.5XL", "size": "2rem",     "fluid": { "min": "1.75rem",  "max": "2.4rem"   } },
				{ "slug": "4xl",      "name": "4XL",   "size": "2.25rem",  "fluid": { "min": "2rem",     "max": "2.75rem"  } },
				{ "slug": "5xl",      "name": "5XL",   "size": "3rem",     "fluid": { "min": "2.5rem",   "max": "3.75rem"  } },
				{ "slug": "6xl",      "name": "6XL",   "size": "3.75rem",  "fluid": { "min": "3rem",     "max": "4.5rem"   } },
				{ "slug": "7xl",      "name": "7XL",   "size": "4.5rem",   "fluid": { "min": "3.5rem",   "max": "5.5rem"   } },
				{ "slug": "8xl",      "name": "8XL",   "size": "6rem",     "fluid": { "min": "4.5rem",   "max": "7rem"     } },
				{ "slug": "9xl",      "name": "9XL",   "size": "8rem",     "fluid": { "min": "6rem",     "max": "9rem"     } }
			],
			"lineHeight": true,
			"fontFamilies": [
				{
					"name": "Body Font",
					"slug": "body-font",
					"fontFamily": "'Work Sans', system-ui, sans-serif"
				},
				{
					"name": "Heading Font",
					"slug": "heading-font",
					"fontFamily": "Literata, Georgia, serif"
				}
			]
		},
		"useRootPaddingAwareAlignments": true
	},
	"styles": {
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|contrast"
		},
		"spacing": {
			"blockGap": "1.2rem",
			"padding": {
				"left": "var:preset|spacing|50",
				"right": "var:preset|spacing|50"
			}
		},
		"typography": {
			"fontFamily": "var:preset|font-family|body-font",
			"fontSize": "var:preset|font-size|base",
			"letterSpacing": "-0.1px",
			"lineHeight": "1.4"
		},
		"blocks": {
			"core/avatar": {
				"border": {
					"radius": "100px"
				}
			},
			"core/button": {
				"variations": {
					"outline": {
						"border": {
							"color": "var:preset|color|contrast",
							"width": "1px"
						},
						"spacing": {
							"padding": {
								"bottom": "calc(1rem - 1px)",
								"left": "calc(2.25rem - 1px)",
								"right": "calc(2.25rem - 1px)",
								"top": "calc(1rem - 1px)"
							}
						}
					}
				}
			},
			"core/columns": {
				"spacing": {
					"blockGap": "var:preset|spacing|50"
				}
			},
			"core/buttons": {
				"spacing": {
					"blockGap": "16px"
				}
			},
			"core/code": {
				"typography": {
					"fontFamily": "var:preset|font-family|body-font",
					"fontSize": "var:preset|font-size|base",
					"fontWeight": "300"
				},
				"color": {
					"background": "#f5f5f5",
					"text": "var:preset|color|contrast"
				},
				"spacing": {
					"padding": {
						"right": "var:preset|spacing|40",
						"bottom": "var:preset|spacing|40",
						"left": "var:preset|spacing|40",
						"top": "var:preset|spacing|40"
					}
				}
			},
			"core/comment-author-name": {
				"color": {
					"text": "var:preset|color|contrast"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var:preset|color|contrast"
						},
						"typography": {
							"textDecoration": "none"
						},
						":hover": {
							"typography": {
								"textDecoration": "underline"
							}
						}
					}
				},
				"typography": {
					"fontSize": "var:preset|font-size|sm"
				},
				"spacing": {
					"margin": {
						"top": "5px",
						"bottom": "0px"
					}
				}
			},
			"core/comment-content": {
				"typography": {
					"fontSize": "var:preset|font-size|base"
				},
				"spacing": {
					"margin": {
						"top": "var:preset|spacing|30",
						"bottom": "var:preset|spacing|30"
					}
				}
			},
			"core/comment-date": {
				"typography": {
					"fontSize": "var:preset|font-size|sm"
				},
				"color": {
					"text": "var:preset|color|contrast"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var:preset|color|contrast"
						}
					}
				}
			},
			"core/comment-edit-link": {
				"elements": {
					"link": {
						"color": {
							"text": "var:preset|color|contrast"
						}
					}
				},
				"typography": {
					"fontSize": "var:preset|font-size|sm"
				}
			},
			"core/comment-reply-link": {
				"elements": {
					"link": {
						"color": {
							"text": "var:preset|color|contrast"
						}
					}
				},
				"typography": {
					"fontSize": "var:preset|font-size|sm"
				}
			},
			"core/post-comments-form": {
				"css": "& textarea, input:not([type=submit]){border-radius:.25rem; border-color: #e5e5e5 !important;} & input[type=checkbox]{margin:0 .2rem 0 0 !important;} & label {font-size: var(--wp--preset--font-size--sm); }",
				"typography": {
					"fontSize": "var:preset|font-size|base"
				},
				"spacing": {
					"padding": {
						"top": "var:preset|spacing|40",
						"bottom": "var:preset|spacing|40"
					}
				}
			},
			"core/comments-pagination": {
				"typography": {
					"fontSize": "var:preset|font-size|base"
				},
				"spacing": {
					"margin": {
						"top": "var:preset|spacing|40",
						"bottom": "var:preset|spacing|40"
					}
				}
			},
			"core/comments-pagination-next": {
				"typography": {
					"fontSize": "var:preset|font-size|base"
				}
			},
			"core/comments-pagination-numbers": {
				"typography": {
					"fontSize": "var:preset|font-size|base"
				}
			},
			"core/comments-pagination-previous": {
				"typography": {
					"fontSize": "var:preset|font-size|base"
				}
			},
			"core/post-date": {
				"color": {
					"text": "var:preset|color|contrast"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var:preset|color|contrast"
						},
						":hover": {
							"typography": {
								"textDecoration": "underline"
							}
						},
						"typography": {
							"textDecoration": "none"
						}
					}
				},
				"typography": {
					"fontSize": "var:preset|font-size|sm"
				}
			},
			"core/post-navigation-link": {
				"typography": {
					"fontSize": "var:preset|font-size|base"
				}
			},
			"core/post-terms": {
				"css": "& a { white-space: nowrap; }",
				"typography": {
					"fontSize": "var:preset|font-size|sm",
					"fontWeight": "600"
				}
			},
			"core/post-title": {
				"typography": {
					"fontFamily": "var:preset|font-family|heading-font",
					"fontWeight": "700",
					"fontSize": "var:preset|font-size|4xl",
					"lineHeight": "1.2"
				},
				"color": {
					"text": "var:preset|color|contrast"
				},
				"elements": {
					"link": {
						":hover": {
							"typography": {
								"textDecoration": "underline"
							}
						},
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			},
			"core/quote": {
				"border": {
					"style": "solid",
					"width": "0 0 0 2px",
					"color": "currentColor"
				},
				"spacing": {
					"blockGap": "var:preset|spacing|30",
					"margin": {
						"left": "0",
						"right": "0"
					},
					"padding": {
						"top": "var:preset|spacing|30",
						"right": "var:preset|spacing|40",
						"bottom": "var:preset|spacing|30",
						"left": "var:preset|spacing|40"
					}
				},
				"typography": {
					"fontFamily": "var:preset|font-family|heading-font",
					"fontSize": "var:preset|font-size|lg",
					"fontWeight": "300"
				},
				"elements": {
					"cite": {
						"typography": {
							"fontSize": "var:preset|font-size|sm",
							"fontStyle": "normal",
							"fontWeight": "300"
						},
						"css": "& sub { font-size: 0.65em }"
					}
				},
				"css": "&.has-text-align-right { border-width: 0 2px 0 0; } &.has-text-align-center { border-width: 0;border-inline: 0; padding-inline: 0; }",
				"variations": {
					"plain": {
						"border": {
							"color": "transparent",
							"style": "none",
							"width": "0",
							"radius": "0"
						},
						"spacing": {
							"padding": {
								"top": "0",
								"right": "0",
								"bottom": "0",
								"left": "0"
							}
						}
					}
				}
			},
			"core/pullquote": {
				"typography": {
					"fontFamily": "var:preset|font-family|heading-font",
					"fontSize": "var:preset|font-size|3xl",
					"fontWeight": "300",
					"lineHeight": "1.2"
				},
				"elements": {
					"cite": {
						"typography": {
							"fontSize": "var:preset|font-size|sm",
							"fontStyle": "normal"
						}
					}
				},
				"spacing": {
					"padding": {
						"bottom": "var:preset|spacing|30",
						"top": "var:preset|spacing|30"
					}
				},
				"css": "& p:last-of-type {margin-bottom: var(--wp--preset--spacing--30);}"
			},
			"core/query-pagination": {
				"typography": {
					"fontSize": "var:preset|font-size|base",
					"fontWeight": "500"
				}
			},
			"core/search": {
				"css": "& .wp-block-search__input{border-radius:3.125rem;padding-left:1.5625rem;padding-right:1.5625rem;border-color:#e5e5e5;}",
				"typography": {
					"fontSize": "var:preset|font-size|base",
					"lineHeight": "1.6"
				},
				"elements": {
					"button": {
						"border": {
							"radius": "0.5rem"
						},
						"spacing": {
							"margin": {
								"left": "1.125rem"
							}
						},
						":hover": {
							"border": {
								"color": "transparent"
							}
						}
					}
				}
			},
			"core/separator": {
				"border": {
					"color": "currentColor",
					"style": "solid",
					"width": "0 0 1px 0"
				},
				"color": {
					"text": "#e5e5e5"
				},
				"variations": {
					"shorty": {
						"border": {
							"color": "currentColor",
							"width": "5px 0 0 0"
						},
						"css": "max-width: 40px; margin-left: 0!important; margin-right: auto; border-style: solid;"
					}
				}
			},
			"core/site-tagline": {
				"typography": {
					"fontSize": "var:preset|font-size|base"
				}
			},
			"core/site-title": {
				"typography": {
					"fontFamily": "var:preset|font-family|heading-font",
					"fontWeight": "700",
					"letterSpacing": "-.5px"
				},
				"elements": {
					"link": {
						"typography": {
							"textDecoration": "none"
						},
						":hover": {
							"typography": {
								"textDecoration": "underline"
							}
						}
					}
				}
			},
			"core/term-description": {
				"typography": {
					"fontSize": "var:preset|font-size|base"
				}
			},
			"core/navigation": {
				"typography": {
					"fontSize": "var:preset|font-size|base"
				},
				"elements": {
					"link": {
						":hover": {
							"typography": {
								"textDecoration": "underline"
							}
						},
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			},
			"core/list": {
				"css": "& li{margin-top: 0.5rem;}"
			},
			"core/image": {
				"border": {
					"radius": "0.75rem"
				}
			},
			"core/media-text": {
				"css": ".wp-block-media-text .wp-block-media-text__media img{border-radius:0.75rem;}"
			}
		},
		"elements": {
			"button": {
				"color": {
					"background": "var:preset|color|contrast",
					"text": "var:preset|color|base"
				},
				"border": {
					"radius": "0.5rem",
					"color": "transparent",
					"style": "solid",
					"width": "2px"
				},
				":focus": {
					"outline": {
						"color": "var:preset|color|contrast",
						"offset": "2px"
					}
				},
				":hover": {
					"color": {
						"background": "color-mix(in srgb, var(--wp--preset--color--contrast) 85%, transparent)",
						"text": "var:preset|color|base"
					},
					"border": {
						"color": "transparent"
					}
				},
				"spacing": {
					"padding": {
						"bottom": "1rem",
						"left": "2.25rem",
						"right": "2.25rem",
						"top": "1rem"
					}
				},
				"typography": {
					"fontSize": "clamp(0.95rem, 0.95rem + ((1vw - 0.2rem) * 0.278), 1.1rem)"
				}
			},
			"caption": {
				"typography": {
					"fontSize": "clamp(0.8rem, 0.8rem + ((1vw - 0.2rem) * 0.278), 0.95rem)",
					"lineHeight": "1.4"
				}
			},
			"h1": {
				"typography": {
					"fontFamily": "var:preset|font-family|heading-font",
					"fontSize": "clamp(3rem, 3rem + ((1vw - 0.2rem) * 2.778), 4.5rem)",
					"lineHeight": "1.1",
					"fontWeight": "700"
				},
				"color": {
					"text": "var:preset|color|contrast"
				}
			},
			"h2": {
				"typography": {
					"fontFamily": "var:preset|font-family|heading-font",
					"fontSize": "clamp(2rem, 2rem + ((1vw - 0.2rem) * 1.389), 2.75rem)",
					"lineHeight": "1.2",
					"fontWeight": "600"
				}
			},
			"h3": {
				"typography": {
					"fontFamily": "var:preset|font-family|heading-font",
					"fontSize": "clamp(1.5rem, 1.5rem + ((1vw - 0.2rem) * 1.389), 2.25rem)",
					"lineHeight": "1.2",
					"fontWeight": "600"
				}
			},
			"h4": {
				"typography": {
					"fontFamily": "var:preset|font-family|heading-font",
					"fontSize": "clamp(1.25rem, 1.25rem + ((1vw - 0.2rem) * 0.926), 1.75rem)",
					"lineHeight": "1.2",
					"fontWeight": "500"
				}
			},
			"h5": {
				"typography": {
					"fontFamily": "var:preset|font-family|heading-font",
					"fontSize": "clamp(1.1rem, 1.1rem + ((1vw - 0.2rem) * 0.556), 1.4rem)",
					"lineHeight": "1.2",
					"fontWeight": "500"
				}
			},
			"h6": {
				"typography": {
					"fontFamily": "var:preset|font-family|heading-font",
					"fontSize": "clamp(1rem, 1rem + ((1vw - 0.2rem) * 0.463), 1.25rem)",
					"lineHeight": "1.2",
					"fontWeight": "700",
					"letterSpacing": "0.05em"
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var:preset|font-family|heading-font",
					"lineHeight": "1.125",
					"letterSpacing": "-0.1px"
				}
			},
			"link": {
				"color": {
					"text": "currentColor"
				},
				":hover": {
					"typography": {
						"textDecoration": "none"
					}
				}
			}
		}
	},
	"templateParts": [
		{
			"area": "header",
			"name": "header",
			"title": "Header"
		},
		{
			"area": "footer",
			"name": "footer",
			"title": "Footer"
		}
	]
}
